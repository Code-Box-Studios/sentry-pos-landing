DATABASE_URI=postgresql://cms_user:cms_dev_password@localhost:5433/sentry
PAYLOAD_SECRET=dev-only-secret-change-me

# Where the portal reaches sentry-pos-be. Server-side only: this must NEVER be prefixed
# NEXT_PUBLIC_ — the browser never calls the API directly, and must not learn its address,
# let alone hold a token for it.
API_URL=http://localhost:4000/v1

# Where the landing page's "Sign in" button goes — now the portal in this same app, so a
# relative path is enough. In production the portal is served from app.sentry.com; set the
# absolute URL there if the marketing site and the app end up on separate deployments.
NEXT_PUBLIC_APP_SIGNIN_URL=/login
